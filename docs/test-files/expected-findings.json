{
  "policy": "balanced",
  "note": "Detection follows src/lib/pii.ts. DOB, names, routing numbers, and passwords are not pattern families at balanced.",
  "files": {
    "customer-case.docx": {
      "format": "docx",
      "expectCategories": [
        "email",
        "SSN",
        "phone",
        "secret",
        "address"
      ],
      "location": "paragraph / document body"
    },
    "service-agreement.pdf": {
      "format": "pdf",
      "expectCategories": [
        "email",
        "SSN",
        "card number",
        "secret"
      ],
      "location": "page text"
    },
    "employee-register.xlsx": {
      "format": "xlsx",
      "expectCategories": [
        "email",
        "SSN",
        "phone",
        "secret"
      ],
      "location": "sheet/cell via provenance.range"
    },
    "support-tickets.csv": {
      "format": "csv",
      "expectCategories": [
        "email",
        "secret"
      ],
      "location": "sheet/cell via provenance.range"
    },
    "incident-notes.txt": {
      "format": "txt",
      "expectCategories": [
        "email",
        "IP address",
        "secret",
        "phone"
      ],
      "location": "plain text"
    },
    "app-config.json": {
      "format": "json",
      "expectCategories": [
        "email",
        "SSN",
        "secret"
      ],
      "location": "nested object keys preserved"
    }
  },
  "controls": {
    "privateIpSafeListed": "10.0.4.12",
    "luhnFailTrace": "1234567890123456",
    "harmlessProse": "the deploy finished and the queue drained normally"
  }
}
