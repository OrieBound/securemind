    "@aws-sdk/client-cognito-identity-provider": "^3.1101.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1101.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1121.0",
    "@aws-sdk/credential-providers": "^3.1101.0",
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.14.0",
    "dotenv": "^17.4.2",
    "emoji-picker-react": "^4.19.1",
    "exceljs": "^4.4.0",
    "groq-sdk": "^1.2.0",
    "jose": "^6.2.7",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "qrcode-generator": "^1.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^21.0.4",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^4.1.10"
