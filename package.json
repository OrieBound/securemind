{
  "name": "securemind",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus:write": "npx tsx scripts/write-regression-corpus.ts",
    "typecheck": "tsc --noEmit",
    "route-eval": "npx tsx scripts/route-eval.ts",
    "knowledge:reindex": "npx tsx scripts/reindex-knowledge.ts",
    "totp": "npx tsx scripts/totp.ts",
    "rag:eval": "npx tsx scripts/rag-eval.ts",
    "pricing:check": "node scripts/check-pricing.mjs",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db floci ollama ollama-init",
    "docker:down": "docker compose down",
    "docker:onprem": "docker compose up --build",
    "docker:onprem:down": "docker compose down -v",
    "backup:onprem": "node scripts/backup-onprem.mjs",
    "floci:cognito": "node scripts/floci-cognito-setup.mjs",
    "floci:dynamodb": "node scripts/floci-dynamodb-setup.mjs",
    "infra:package": "node infra/scripts/package-lambda.mjs",
    "infra:deploy": "node infra/scripts/deploy.mjs",
    "infra:teardown": "node infra/scripts/teardown.mjs",
    "infra:validate": "node infra/scripts/validate.mjs",
    "infra:up": "node infra/scripts/up.mjs",
    "infra:down": "node infra/scripts/down.mjs",
    "infra:wire": "node infra/scripts/wire.mjs",
    "infra:migrate-vendor-keys": "node infra/scripts/migrate-vendor-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1152.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "exceljs": "^4.4.0",
    "groq-sdk": "^1.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode-generator": "^1.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^20.11.1",
    "pdf-lib": "^1.17.1",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
