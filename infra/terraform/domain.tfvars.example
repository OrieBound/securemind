# Copy to domain.auto.tfvars (git-ignored) to put the hosted edition on your own domain.
# Walkthrough: docs/deploy/custom-domain.md
#
# Stage 1: set only domain_name, apply, and point your registrar's nameservers at the
#          route53_name_servers output. Wait until they take effect.
# Stage 2: add the lines below, apply, run `npm run infra:wire`, then deploy the app again.

domain_name = "example.com"

# enable_custom_domains = true
# app_subdomain         = "app"     # https://app.example.com
# api_subdomain         = "api"     # https://api.example.com (optional)

# Records for sites hosted elsewhere, and any you copy over from the registrar.
# Key is the host without the domain, or "@" for the apex ("@/MX" adds a second type at the apex).
# extra_dns_records = {
#   "www"    = { type = "CNAME", values = ["d111111abcdef8.cloudfront.net"] }
#   "sample" = { type = "A", alias = { name = "d222222abcdef8.cloudfront.net", zone_id = "Z2FDTNDATAQYW2" } }
# }

# Static websites on S3 + CloudFront (a marketing page, a demo). Each gets its own certificate,
# DNS records and a role that its GitHub repository can use to upload files, with no stored keys.
# Needs the zone above. Read each prefix with:
#   gh api repos/OWNER/REPO/actions/oidc/customization/sub   (sub_claim_prefix)
# static_sites = {
#   marketing = {
#     aliases                  = ["example.com", "www.example.com"]  # the first is the main address
#     redirect_others_to_first = true                                # www -> example.com
#     github_subject_prefix    = "repo:OWNER@111/marketing@222"
#   }
#   sample = {
#     aliases               = ["sample.example.com"]
#     github_subject_prefix = "repo:OWNER@111/sample@333"
#   }
# }
