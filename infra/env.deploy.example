#####################################################################
# SecureMind — sandbox / cloud deploy inputs (Terraform)
#
#   1. aws sso login --profile your-profile
#   2. copy this file to the repo root as .env.deploy  (gitignored)
#   3. One-time bootstrap: see infra/README.md
#   4. npm run infra:up
#
# Default cloud database is DynamoDB. Do not set DATABASE_URL unless you
# are explicitly opting into Neon/Aurora (not the default path).
#
# Local on-prem: docker compose up --build — do not use this file.
#####################################################################

# AWS
AWS_PROFILE="your-profile"
AWS_REGION="us-east-1"
ENV_NAME="your-env"

DATABASE_MODE="dynamodb"
STORAGE_BACKEND="dynamodb"
EMBED_DIMENSIONS="1024"
EMBED_PROVIDER="bedrock"

# Optional bootstrap inference key (Parameter Store SecureString). Empty = omit the parameter.
GROQ_API_KEY=""

# First admin is created in the Amplify UI (empty pool + terraform output -raw setup_claim_secret).
# Do not seed ADMIN_EMAIL here.

AMPLIFY_BRANCH="main"
# After the first Amplify URL exists:
# AMPLIFY_SITE_URL="https://main.dxxxx.amplifyapp.com"

AUTH_MODE="cognito"
AUTH_ALLOW_LOCAL_FALLBACK="false"
