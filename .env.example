#####################################################################
# SecureMind — environment template
#
# Copy this file to .env.local and fill in the values:
#     cp .env.example .env.local
#
# .env.local is gitignored. Never commit real credentials.
#####################################################################

# ── Database (required for local development) ───────────────────────
# Local and on-prem: Postgres + pgvector (Docker Compose, or any Postgres you run).
# Hosted AWS: DynamoDB with native vector search (ADR 0007), created by Terraform
# (`npm run infra:up`). The hosted app does not use DATABASE_URL.
#
# Local Docker database (start it with docker-compose.dev.yml so port 5432 is reachable):
#   DATABASE_URL="postgresql://securemind:securemind@localhost:5432/securemind"
#   DIRECT_URL="postgresql://securemind:securemind@localhost:5432/securemind"
#
# DATABASE_URL is used by the app at runtime (pooled connection).
# DIRECT_URL is used by Prisma CLI for migrations (unpooled).
# With a non-pooled local Postgres, set both to the same value.
#
# After the database exists, enable pgvector once (Compose does this
# automatically on first boot via scripts/docker-init-pgvector.sql):
#     psql "$DIRECT_URL" -f scripts/add-vector-embedding.sql
DATABASE_URL="postgresql://user:password@host/securemind?sslmode=require"
DIRECT_URL="postgresql://user:password@host/securemind?sslmode=require"
#
# DynamoDB adapter, for trying the hosted storage locally against Floci:
# STORAGE_BACKEND="postgres"              # default; "dynamodb" opts into the adapter
# DYNAMODB_FRAGMENTS_TABLE="securemind-fragments"
# DYNAMODB_REGION="us-east-1"
# DYNAMODB_VECTOR_ENGINE=""               # unset = SearchVectors then Query+cosine; "memory" = in-process
# DynamoDB clients use AWS_ENDPOINT_URL (Floci) when set — same as Cognito.
#
# Hosted only. Terraform sets these; you do not set them by hand:
#   SECUREMIND_EDITION="cloud"            # hosted edition (Docker and npm run dev are "local")
#   APP_SECRETS_PARAM="/securemind/<env>/app-secrets"      # Parameter Store: encryption key + setup code
#   VENDOR_KEYS_PARAM="/securemind/<env>/vendor-keys"      # Parameter Store: Admin-pasted vendor keys
#   GROQ_API_KEY_PARAM="/securemind/<env>/groq-api-key"    # optional deploy-time Groq key
#   ALLOWED_ORIGIN="https://app.example.com"              # chat API CORS: the app's own origin
#   TRANSCRIBE_STREAM_ROLE_ARN / TRANSCRIBE_STREAM_REGION  # direct live voice captions (ADR 0009)
# Local and on-prem installs keep Admin-pasted vendor keys encrypted in the database instead.

# ── Groq inference (optional BYOK) ──────────────────────────────────
# Not required. Local installs prefer Ollama when a chat model is already
# installed. Hosted/cloud installs do not use a product-operated Groq key
# as a silent default — paste a key in Settings (Admin) or use Bedrock.
GROQ_API_KEY=""

# Cheapest model, used for background summarize/extract and for the
# routing tiebreak classifier. Leave unset to use the default.
# GROQ_FAST_MODEL="llama-3.1-8b-instant"

# Vision model for image → searchable Knowledge text. Default is Llama 4 Scout.
# GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# ── Ollama (recommended local inference, optional) ─────────────────
# Install from https://ollama.com/download. Host `npm run dev` inspects
# installed tags and will not silently pull a model.
# Docker on-prem (`docker compose up --build`) pulls nomic-embed-text and
# llama3.2:3b into the Compose volume on first boot.
# Guided host default: llama3.2:3b (optional enhanced: gemma3:4b).
#     ollama pull llama3.2:3b
#     ollama pull nomic-embed-text     # Knowledge embeddings
#
# Semantic retrieval and document embedding need nomic-embed-text.
# Without Ollama the app still runs — documents are stored and readable,
# but semantic search is unavailable.
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_CHAT_MODEL="llama3.2"
# OLLAMA_EMBED_MODEL="nomic-embed-text"
# OLLAMA_FALLBACK_MODEL="mistral"

# ── Model provider override (optional) ──────────────────────────────
# Leave unset for automatic routing (local: Groq if configured, else installed
# Ollama; cloud: Bedrock if IAM is ready, else Admin BYOK, else no LLM).
# Set to "bedrock" to force the Bedrock adapter (requires AWS credentials — see below).
# MODEL_PROVIDER="bedrock"
# BEDROCK_CHAT_MODEL=""        # a model id from Settings → Models (Bedrock retires versions)
# BEDROCK_VISION_MODEL="amazon.nova-lite-v1:0"   # image text extract on hosted installs
# BEDROCK_REGION=""            # embeddings region when it differs from the app's

# ── Amazon Bedrock ──────────────────────────────────────────────────
# Nothing is required here. Profile, region, and the billable-call switch
# are configured in the app: Settings → Models → Amazon Bedrock.
#
# SecureMind never accepts AWS credential material through the UI and never
# stores it in the database. The AWS SDK provider chain resolves it from this
# machine, exactly like the AWS CLI:
#
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#   2. ~/.aws/credentials or ~/.aws/config  (incl. `aws sso login`)
#   3. Container role (App Runner / ECS)
#   4. EC2 instance role
#
# Running `npm run dev` on your own computer: use the AWS CLI, then pick the profile in the app:
#   aws configure sso
#   aws sso login --profile my-profile
# Running in Docker: the app cannot see your ~/.aws. Share ONE profile on purpose:
#   npm run bedrock:profile -- my-profile
#   docker compose -f docker-compose.yml -f docker-compose.bedrock.yml up -d
# That copies only that profile into ./aws-profile next to docker-compose.yml (set
# SECUREMIND_AWS_DIR to use another folder). Where you keep the SecureMind folder does not matter.
# SecureMind does not accept an AWS access key in Settings.
#
# Optional hard kill switch. Setting this to "false" blocks billable AWS
# calls even when an admin enables them in the app — useful for CI and
# locked-down deployments. Leave unset to let the app setting decide.
# ALLOW_REAL_AWS="false"
#
# Only this variable redirects Bedrock. AWS_ENDPOINT_URL (Floci) is ignored
# by the Bedrock client — Floci stubs ConverseStream with a 501.
# AWS_ENDPOINT_URL_BEDROCK=""

# ── Remote API (optional — Amplify UI + API Gateway) ────────────────
# One-button cloud: copy infra/env.deploy.example → .env.deploy, then:
#   aws sso login --profile …
#   npm run infra:up
# Leave NEXT_PUBLIC_API_BASE_URL unset for localhost same-origin /api/*.
# NEXT_PUBLIC_API_BASE_URL="https://xxxx.execute-api.us-east-1.amazonaws.com/prod"
# Hosted edition: a page that says how to ask for an invitation. Shown on the sign-in screen.
# NEXT_PUBLIC_ACCESS_CONTACT_URL="https://example.com/contact/"
# See infra/README.md.
#
# Embeddings: local default Ollama (768-d). Lambda/cloud default Bedrock Titan v2.
# EMBED_PROVIDER="ollama"
# EMBED_DIMENSIONS="768"
# BEDROCK_EMBED_MODEL="amazon.titan-embed-text-v2:0"
# DOCUMENT_INGEST_SYNC="true"   # force await processDocument (always on in Lambda)
#
# Original Knowledge files (never stored in Postgres). Default: .data/uploads
# DOCUMENT_STORAGE_PATH=".data/uploads"
# Profile photos: host dev uses .data/avatars. Docker Compose uses /data/avatars
# on the same volume as Knowledge files. Hosted Lambda uses a private S3 bucket
# from Terraform (AVATAR_S3_BUCKET) via IAM — not a UI key.
# AVATAR_STORAGE_PATH=".data/avatars"
# AVATAR_S3_BUCKET=""
# Portal logo (Settings → Branding). Default .data/portal; Docker uses /data/portal.
# PORTAL_STORAGE_PATH=".data/portal"
# Admin price overrides for cost estimates. Default .data/pricing-overrides.json.
# PRICING_OVERRIDES_FILE=""
# Docker behind the optional HTTPS front end (docker-compose.tls.yml sets this).
# SECUREMIND_HTTPS="true"
# Encrypt Admin-entered vendor keys at rest. 64-char hex or any passphrase.
# If unset, a key is generated at INSTANCE_KEY_FILE (default .data/instance.key).
# INSTANCE_ENCRYPTION_KEY=""
# INSTANCE_KEY_FILE=".data/instance.key"

# ── Floci local emulator (optional) ─────────────────────────────────
# docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d floci
#   → Floci on http://localhost:4566 (the base compose file publishes only the app port)
# Used for Cognito and DynamoDB item APIs. SearchVectors is not emulated; the adapter
# falls back to Query + cosine.
# AWS_ENDPOINT_URL="http://localhost:4566"
# AWS_ACCESS_KEY_ID="test"
# AWS_SECRET_ACCESS_KEY="test"

# ── Auth (optional) ─────────────────────────────────────────────────
# AUTH_MODE:
#   local       — fixed userId "local" (default; current personal project)
#   jwt-hs256   — verify Bearer JWT with AUTH_DEV_JWT_SECRET (local demos)
#   cognito     — verify cookie/Bearer JWT against Cognito JWKS (Floci or AWS)
#
# Real AWS Cognito (invite-only) comes from Terraform (`npm run infra:up`); `npm run infra:wire`
#   copies the pool and client ids into the hosted app. See infra/README.md.
#
# Floci Cognito experiment ($0 — requires Docker + `docker compose up -d floci`):
#   node scripts/floci-cognito-setup.mjs
#   then copy the printed lines into this file (also written to scripts/.floci-cognito.env)
#
# AUTH_MODE="local"
# AUTH_ALLOW_LOCAL_FALLBACK="false"   # production builds default to false; "true" is for host dev only
# ALLOW_INSECURE_LOCAL_IDENTITY="true" # production build with AUTH_MODE=local: single-user machine only
# AUTH_DEV_JWT_SECRET=""
# AWS_ENDPOINT_URL="http://localhost:4566"
# AWS_ACCESS_KEY_ID="test"
# AWS_SECRET_ACCESS_KEY="test"
# COGNITO_REGION="us-east-1"
# COGNITO_USER_POOL_ID=""
# COGNITO_CLIENT_ID=""
# COGNITO_ISSUER="http://localhost:4566/<poolId>"
# COGNITO_JWKS_URL="http://localhost:4566/<poolId>/.well-known/jwks.json"
#
# Hosted first-admin (Amplify): Terraform stores SETUP_CLAIM_SECRET (and INSTANCE_ENCRYPTION_KEY) in
# Parameter Store (APP_SECRETS_PARAM); the server loads them at startup. Do not put them in Amplify variables.
# Print once with: terraform -chdir=infra/terraform output -raw setup_claim_secret
# Never put this on the public page. Docker Compose makes its own setup code on first boot
# (`docker compose logs init | grep "setup code"`). Only host `npm run dev` lets the first
# visitor claim Owner with email + password and no setup code.
# SETUP_CLAIM_SECRET=""

# ── Outbound email (optional) ───────────────────────────────────────
# Used when an Admin creates a user: "You've been added to SecureMind".
# Cognito invite mail is suppressed on purpose (password is set in-app);
# this SMTP path is the product welcome notice. Never put passwords in email.
#
# APP_PUBLIC_URL="http://localhost:3000"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="SecureMind <noreply@example.com>"
